# Response headers for Cloudflare Pages (TSD §11.1). Pages reads this file at deploy time and
# does not serve it (https://developers.cloudflare.com/pages/configuration/headers/). Other
# hosts, and `vite preview`, serve it as a plain file and apply none of it.

# The app sends no referrer (app.html's meta tag, the API client): the same for every response,
# instead of Pages' default strict-origin-when-cross-origin. The app is never framed.
/*
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# The two pages: Pages' default caching (revalidate on every load), plus no-transform, so that
# Cloudflare cannot rewrite them to inject scripts such as the Web Analytics beacon (GOALS §4.5;
# https://developers.cloudflare.com/web-analytics/get-started/). Web Analytics must stay off
# in any case.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/p
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Content-hashed build output: cached for a year, as SvelteKit's own preview server does.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
